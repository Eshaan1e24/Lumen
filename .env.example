# Free key from https://aistudio.google.com  (never commit your real .env)
GEMINI_API_KEY=your-key-here
# Optional: comma-separated model names to try first. Defaults: gemini-3.8-flash, gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-3.8-flash
# Optional limits (defaults shown)
# LUMEN_MAX_UPLOAD_MB=5
# LUMEN_ASK_PER_10MIN=8
# LUMEN_ASK_PER_DAY=60
# LUMEN_ASK_GLOBAL_PER_DAY=400
# LUMEN_TRUST_PROXY=1     # only behind a reverse proxy such as Render
